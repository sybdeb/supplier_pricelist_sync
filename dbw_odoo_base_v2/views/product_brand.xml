<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Brand Tree View -->
    <record id="view_product_brand_list" model="ir.ui.view">
        <field name="name">product.brand.list</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <list string="Product Brands">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="products_count"/>
            </list>
        </field>
    </record>

    <!-- Product Brand Form View -->
    <record id="view_product_brand_form" model="ir.ui.view">
        <field name="name">product.brand.form</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <form string="Product Brand">
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" string="Brand Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Samsung, Apple, etc."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="products_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Brand description..."/>
                        </page>
                        <page string="Products">
                            <field name="product_ids">
                                <list string="Products">
                                    <field name="default_code"/>
                                    <field name="name"/>
                                    <field name="list_price"/>
                                    <field name="standard_price"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Product Brand Search View -->
    <record id="view_product_brand_search" model="ir.ui.view">
        <field name="name">product.brand.search</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <search string="Search Brands">
                <field name="name"/>
                <field name="partner_id"/>
                <separator/>
                <filter string="Has Partner" name="has_partner" domain="[('partner_id', '!=', False)]"/>
                <separator/>
                <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <!-- Product Brand Kanban View -->
    <record id="view_product_brand_kanban" model="ir.ui.view">
        <field name="name">product.brand.kanban</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="logo"/>
                <field name="products_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('product.brand', 'logo', record.id.raw_value)" alt="Brand Logo"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="products_count"/> products
                                </div>
                                <div>
                                    <field name="partner_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Product Brand Action -->
    <record id="action_product_brand" model="ir.actions.act_window">
        <field name="name">Product Brands</field>
        <field name="res_model">product.brand</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Product Brand
            </p>
            <p>
                Brands are core to the DBW business. Add brands here to categorize products
                and enable brand-specific operations in Supplier Sync, Quality, and Pricing modules.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem
        id="menu_product_brand"
        name="Brands"
        parent="menu_dbw_products"
        action="action_product_brand"
        sequence="10"/>

    <!-- Extend Product Template Form View -->
    <record id="product_template_form_view_brand" model="ir.ui.view">
        <field name="name">product.template.form.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="product_brand_id"/>
            </field>
        </field>
    </record>

    <!-- Extend Product Template Tree View -->
    <record id="product_template_tree_view_brand" model="ir.ui.view">
        <field name="name">product.template.tree.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="product_brand_id" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Extend Product Template Search View -->
    <record id="product_template_search_view_brand" model="ir.ui.view">
        <field name="name">product.template.search.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="product_brand_id"/>
            </field>
            <search position="inside">
                <filter string="Brand" name="group_brand" context="{'group_by': 'product_brand_id'}"/>
            </search>
        </field>
    </record>

</odoo>
