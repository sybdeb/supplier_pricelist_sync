<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Settings Form View -->
    <record id="view_dbw_unified_settings_form" model="ir.ui.view">
        <field name="name">DBW Unified Settings</field>
        <field name="model">dbw.unified.settings</field>
        <field name="arch" type="xml">
            <form string="DBW Settings" class="oe_form_configuration">
                <header>
                    <button string="Save" type="object" name="execute" class="oe_highlight"/>
                    <button string="Cancel" type="object" name="cancel" class="btn-secondary"/>
                    <button string="Refresh Modules" type="object" name="action_refresh_modules" class="btn-link"/>
                </header>
                <sheet>
                    <div class="app_settings_block" data-string="General" data-key="dbw_general">
                        <h2>General Settings</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="enable_debug_logging"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="enable_debug_logging"/>
                                    <div class="text-muted">
                                        Enable detailed logging for troubleshooting
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="auto_update_check"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="auto_update_check"/>
                                    <div class="text-muted">
                                        Automatically check for module updates
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Placeholder for module settings -->
                    <div class="app_settings_block mt32" data-string="Module Settings" data-key="dbw_modules">
                        <h2>Module Settings</h2>
                        <div class="row mt16">
                            <div class="col-12">
                                <div class="alert alert-info">
                                    <p class="mb-0">
                                        <i class="fa fa-info-circle"/> Module-specific settings will appear here when you install DBW modules.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
