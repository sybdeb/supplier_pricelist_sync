<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job to check and trigger scheduled supplier imports -->
        <record id="ir_cron_check_scheduled_imports" model="ir.cron">
            <field name="name">Check Scheduled Supplier Imports</field>
            <field name="model_id" ref="dbw_odoo_base_v2.model_dbw_processing_queue"/>
            <field name="state">code</field>
            <field name="code">model.check_scheduled_imports()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
